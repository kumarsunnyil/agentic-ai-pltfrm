# WEB Folders
# Dependencies
/apps/web/node_modules
/node_modules
#/docs
#/infrastructure
#packages
/.pnp
.pnp.js

# pnpm specific store and lock artifacts
.pnpm-store/
pnpm-debug.log*

# Next.js build output
/.next/
/out/
/build

# Vercel deployment artifacts
/.vercel

# Testing and coverage
/coverage
/.nyc_output

# Local environment files (Contains sensitive API keys)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# TypeScript
*.tsbuildinfo

# Operating System files
.DS_Store
Thumbs.db


# API FOLDERs
##################################################################

# Compiled output
/apps/api/node_modules
/apps/api/dist

# Logs
/apps/api/logs
*.log
/apps/api/npm-debug.log*
/apps/api/yarn-debug.log*
/apps/api/yarn-error.log*
/apps/api/pnpm-debug.log*
/apps/api/lerna-debug.log*

# Runtime data
/apps/api/pids
/apps/api/*.pid
/apps/api/*.seed
/apps/api/*.pid.lock

# Directory for instrumented libs generated by jscoverage/JSCover
lib-cov

# Coverage directory used by tools like istanbul
coverage
*.lcov

# nyc test coverage
/.nyc_output

# NestTS framework directories
.nest

# Optional npm cache directory
.npm

# Output of 'npm pack'
*.tgz

# Yarn Integrity file
.yarn-integrity

# dotenv environment variables files
/apps/api/.env
/apps/api/.env.development
/apps/api/.env.test
/apps/api/.env.production
/apps/api/.env.local
/apps/api/.env.*.local

# parcel-cache
/apps/api/.cache
/apps/api/.parcel-cache

# Next.js build output
/apps/api/.next
/apps/api/out

# Nuxt.js build / generate output
/apps/api/.nuxt
/apps/api/dist

# Gatsby files
/apps/api/.cache/
/apps/api/public/

# vue-cli gitter
/apps/api/dist_electron

# Serverless Webpack directories
/apps/api/.webpack/

# Optional IDEs and text editors
/apps/api/.idea/
/apps/api/.vscode/
/apps/api/*.suo
/apps/api/*.ntvs*
/apps/api/*.njsproj
/apps/api/*.sln
/apps/api/*.sw?

